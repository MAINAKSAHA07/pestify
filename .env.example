VITE_POCKETBASE_URL=https://your-domain.com
POCKETBASE_URL=https://your-domain.com
POCKETBASE_ADMIN_EMAIL=admin@your-domain.com
POCKETBASE_ADMIN_PASSWORD=secure-password

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=your-random-webhook-verify-token
WHATSAPP_OTP_SECRET=your-random-otp-secret-key-32-chars
WHATSAPP_SERVER_PORT=3001

# Frontend → Express API (required for Netlify / pestify.in; optional on pestyfi.com)
VITE_WHATSAPP_API_URL=https://pestyfi.com/api

# Razorpay Payments
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
VITE_RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gemini API (WhatsApp AI Assistant)
GEMINI_API_KEY=your-gemini-api-key

# Web Push (background notifications when PWA is closed)
# Generate with: node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(k.publicKey, k.privateKey)"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:work.mainaksaha@gmail.com
POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
